# Dockerfile for n8n Monitoring Dashboard (Optional)
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for monitoring
RUN pip install --no-cache-dir \
    streamlit \
    plotly \
    pandas \
    redis \
    httpx \
    websockets

# Copy monitoring code
COPY n8n/monitoring/ /app/n8n/monitoring/
COPY framework/scripts/session_manager.py /app/framework/scripts/

# Environment variables
ENV PYTHONPATH=/app
ENV STREAMLIT_SERVER_PORT=8200
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Expose port
EXPOSE 8200

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8200 || exit 1

# Run streamlit dashboard
CMD ["streamlit", "run", "n8n/monitoring/dashboard.py", "--server.port=8200", "--server.address=0.0.0.0"]