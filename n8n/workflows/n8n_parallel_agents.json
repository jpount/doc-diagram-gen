        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent_name\": \"agent-ui-analysis-specialist\",\n  \"session_id\": \"{{ $node[\"extract_session\"].json.session_id }}\",\n  \"wait_for_completion\": true,\n  \"timeout\": 300\n}",
        "options": {
          "timeout": 360000
        }
      },
      "id": "ui_analysis",
      "name": "UI Analysis Specialist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1500, 600],
      "notesInFlow": true,
      "notes": "Analyzes frontend components"
    },
    {
      "parameters": {},
      "id": "merge_results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1750, 400]
    },
    {
      "parameters": {
        "functionCode": "// Combine results from parallel agents\nconst results = {\n  session_id: $node[\"extract_session\"].json.session_id,\n  workflow: \"Parallel Agent Execution\",\n  timestamp: new Date().toISOString(),\n  agents_executed: [],\n  summary: {}\n};\n\n// Process each agent result\nconst agents = [\n  { node: \"java_architect\", name: \"Java Architect\" },\n  { node: \"business_logic\", name: \"Business Logic Analyst\" },\n  { node: \"ui_analysis\", name: \"UI Analysis Specialist\" }\n];\n\nfor (const agent of agents) {\n  try {\n    const agentResult = $node[agent.node].json;\n    if (agentResult && agentResult.success) {\n      results.agents_executed.push(agent.name);\n      results.summary[agent.node] = {\n        status: \"completed\",\n        execution_time: agentResult.execution_time || 0\n      };\n    } else {\n      results.summary[agent.node] = {\n        status: \"failed\",\n        error: agentResult?.error || \"Unknown error\"\n      };\n    }\n  } catch (e) {\n    results.summary[agent.node] = {\n      status: \"error\",\n      error: e.message\n    };\n  }\n}\n\nresults.message = `Parallel execution complete: ${results.agents_executed.length} agents finished`;\nresults.success = results.agents_executed.length > 0;\n\nreturn [{ json: results }];"
      },
      "id": "compile_results",
      "name": "Compile Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1950, 400]
    }
  ],
