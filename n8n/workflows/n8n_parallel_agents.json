        "jsonBody": "={\n  \"agent_name\": \"agent-business-logic-analyst\",\n  \"session_id\": \"{{ $node[\"extract_session\"].json.session_id }}\",\n  \"wait_for_completion\": true,\n  \"timeout\": 300\n}",
        "options": {
          "timeout": 360000
        }
