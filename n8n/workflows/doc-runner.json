    {
      "parameters": {
        "functionCode": "// Combine all results\nconst status = $node[\"Check Status\"].json;\nconst agents = $node[\"Get Completed Agents\"].json;\n\nreturn [{\n  json: {\n    success: true,\n    session_id: status.session_id,\n    workflow_complete: true,\n    progress: status.progress_percentage,\n    agents_completed: status.agents?.completed || [],\n    agents_failed: status.agents?.failed || [],\n    message: `Analysis complete! ${status.agents?.completed?.length || 0} agents finished.`,\n    output_location: '/app/output/docs/',\n    next_steps: [\n      'Check output/docs/ for documentation',\n      'Check output/diagrams/ for visual diagrams',\n      'Review output/context/ for agent summaries'\n    ]\n  }\n}];"
      },
